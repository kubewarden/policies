# This file holds the versions and the checksums of the tools that CI
# installs with .github/actions/install-dependencies. The local build of
# the TinyGo policies also reads it. Renovate updates the values through
# the custom manager in renovate.json. Each version is the exact tag of
# the GitHub release, because Renovate looks up the release by this tag
# to find the new checksum. Bash and /bin/sh both read this file, so use
# only lines of the form NAME="value" and comments.

# renovate: datasource=github-release-attachments depName=kubewarden/adm-controller
KWCTL_VERSION="v1.35.0"
# renovate: datasource=github-release-attachments depName=kubewarden/adm-controller digestVersion=v1.35.0
KWCTL_CHECKSUM="2f518033989a897c2f502a2f4fa90b3ca666eee976a82d045abdea5022330341"

# renovate: datasource=github-release-attachments depName=anchore/syft
SYFT_VERSION="v1.57.0"
# renovate: datasource=github-release-attachments depName=anchore/syft digestVersion=v1.57.0
SYFT_CHECKSUM="9c077a7d43029b3b13e98a8db720661e700c4d58db6352153a06395ae4a2a704"

# renovate: datasource=github-release-attachments depName=WebAssembly/binaryen versioning=regex:^version_(?<major>\d+)$
BINARYEN_VERSION="version_116"
# renovate: datasource=github-release-attachments depName=WebAssembly/binaryen versioning=regex:^version_(?<major>\d+)$ digestVersion=version_116
BINARYEN_CHECKSUM="c55b74f3109cdae97490faf089b0286d3bba926bb6ea5ed00c8c784fc53718fd"

# renovate: datasource=github-release-attachments depName=tinygo-org/tinygo
TINYGO_VERSION="v0.42.0"
# renovate: datasource=github-release-attachments depName=tinygo-org/tinygo digestVersion=v0.42.0
TINYGO_CHECKSUM="2082c4762fea6d5cc4cd1f4a243eaacf07b12f576717d4c6b74828bd163cb563"

# renovate: datasource=github-release-attachments depName=open-policy-agent/opa
OPA_VERSION="v0.65.0"
# renovate: datasource=github-release-attachments depName=open-policy-agent/opa digestVersion=v0.65.0
OPA_CHECKSUM="cd6b0b2d762571a746f0261890b155e6dd71cca90dad6b42b6fcf6dd7f619f08"

# renovate: datasource=github-release-attachments depName=rust-secure-code/cargo-auditable
CARGO_AUDITABLE_VERSION="v0.7.7"
# renovate: datasource=github-release-attachments depName=rust-secure-code/cargo-auditable digestVersion=v0.7.7
CARGO_AUDITABLE_CHECKSUM="7676443367c5e33d9fb22acef63cccb5e9202de12dae1b0579995eb3e2bc7a18"

# cargo install builds auditable2cdx from crates.io, so it has no checksum
# here.
# renovate: datasource=crate depName=auditable2cdx
AUDITABLE2CDX_VERSION="0.1.0"
