{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "schedule:weekends"
  ],
  "labels": ["area/dependencies"],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "ignorePaths": ["policies/kyverno-dsl-policy/go.mod"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the tool versions and checksums in versions.env",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\w+_VERSION=\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))? digestVersion=(?<currentValue>\\S+)\\s*\\n\\w+_CHECKSUM=\"(?<currentDigest>[a-f0-9]{64})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "bundle Rust dependencies updates together",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "Rust dependencies",
      "groupSlug": "rust-updates",
      "semanticCommits": "enabled",
      "semanticCommitType": "build"
    },
    {
      "description": "do not bump github.com/deckarep/golang-set/v2 - latest versions panic at runtime when tinygo is used.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/deckarep/golang-set/v2"],
      "enabled": false
    },
    {
      "description": "bundle Go dependencies updates together",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "Go dependencies",
      "groupSlug": "go-updates",
      "semanticCommits": "enabled",
      "semanticCommitType": "build"
    },
    {
      "description": "bundle GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions-updates",
      "semanticCommits": "enabled",
      "semanticCommitType": "build"
    },
    {
      "description": "keep Go toolchain/go directive updates (in go.mod files and GitHub Actions go-version) in a dedicated PR, separate from dependency bumps",
      "matchManagers": ["gomod", "github-actions"],
      "matchDepNames": ["go"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "semanticCommits": "enabled",
      "semanticCommitType": "build"
    },
    {
      "description": "keep OPA on 0.x. OPA 1.x reads Rego v1 syntax by default, and the Rego policies use v0 syntax",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["open-policy-agent/opa"],
      "allowedVersions": "<1.0.0"
    },
    {
      "description": "bundle the tool updates of versions.env together",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["versions.env"],
      "groupName": "CI tools",
      "groupSlug": "ci-tools",
      "semanticCommits": "enabled",
      "semanticCommitType": "build"
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore"
}
